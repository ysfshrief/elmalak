<?xml version="1.0" encoding="utf-8"?>
<!--
  شاشةُ أوّل تشغيلٍ بلا إنترنت: شعار الكنيسة ونصٌّ عربي يشرح السبب، بدل
  شاشةٍ بيضاء فارغة أو صفحة خطأٍ من المتصفّح.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:gravity="center"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="32dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/splash_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/offline_title"
        android:textColor="@color/ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.35"
        android:text="@string/offline_body"
        android:textColor="@color/inkMuted"
        android:textSize="14sp" />

    <Button
        android:id="@+id/offline_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/colorPrimary"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/offline_retry"
        android:textColor="#FFFDF7" />

    <TextView
        android:id="@+id/offline_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/offline_waiting"
        android:textColor="@color/inkMuted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
