<?xml version="1.0" encoding="utf-8"?>
<!-- اختصاراتٌ من ضغطةٍ مطوّلة على أيقونة التطبيق، تفتح صفحات الموقع نفسه. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="attendance"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_attendance">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/url_attendance" />
    </shortcut>
    <shortcut
        android:shortcutId="visitation"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_visitation">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/url_visitation" />
    </shortcut>
</shortcuts>
