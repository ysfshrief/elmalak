# رابط قاعدة بيانات PostgreSQL.
# في الإنتاج (Vercel) استخدم رابط قاعدة بيانات مستضافة — راجع قسم "النشر على Vercel" في README.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# مفتاح سري لتوقيع جلسات الدخول (JWT) — يجب أن يكون طويلاً وعشوائيًا وسريًا في بيئة الإنتاج.
# لتوليد مفتاح: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-this-to-a-long-random-secret-in-production"

# ————————————————— خزنة صور المخدومين (Google Drive) —————————————————
# معرّف المجلّد الخاص الذي تُحفظ فيه الصور (من رابط المجلّد بعد /folders/).
GOOGLE_DRIVE_FOLDER_ID=""

# طريقة الدخول (١): حساب Google عادي — وهي اللازمة إن كان المجلّد في Drive
# شخصي، لأن حساب الخدمة لا يملك مساحة تخزين فلا يستطيع الرفع إلى Drive شخصي.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""

# طريقة الدخول (٢): حساب خدمة — لا تصلح إلا مع مجلّد داخل «مشغّل مشترك»
# (Shared Drive). ضع ملف JSON كما هو أو مُرمّزًا بـbase64.
GOOGLE_SERVICE_ACCOUNT_JSON=""
