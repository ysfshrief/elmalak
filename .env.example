# رابط قاعدة بيانات PostgreSQL.
# في الإنتاج (Vercel) استخدم رابط قاعدة بيانات مستضافة — راجع قسم "النشر على Vercel" في README.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# مفتاح سري لتوقيع جلسات الدخول (JWT) — يجب أن يكون طويلاً وعشوائيًا وسريًا في بيئة الإنتاج.
# لتوليد مفتاح: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-this-to-a-long-random-secret-in-production"

# ————————————————— خزنة صور المخدومين (Supabase Storage) —————————————————
# الحاوية خاصة ولا تُفتح للعموم. الخادم وحده يرفع ويعرض ويحذف بهذا المفتاح،
# ولا يصل المتصفّح إلى Supabase إطلاقًا.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# مفتاح الخادم السري (Service role / Secret key). لا يُوضع في متغيّر يبدأ
# بـNEXT_PUBLIC، ولا يُستورد في أي مكوّن عميل، ولا يُرفع إلى Git.
SUPABASE_SECRET_KEY=""

# اسم الحاوية — اتركه فارغًا ليُستعمل الافتراضي "child-photos".
# SUPABASE_PHOTO_BUCKET="child-photos"
